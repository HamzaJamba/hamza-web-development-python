# ${API_UPSTREAM} is substituted at container start by the official nginx image.
server {
    listen 80;
    server_name _;
    client_max_body_size 12m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }
    location /admin/  { proxy_pass ${API_UPSTREAM}; proxy_set_header Host $http_host; proxy_set_header X-Forwarded-Proto $scheme; }
    location /static/ { proxy_pass ${API_UPSTREAM}; proxy_set_header Host $http_host; expires 7d; }
    location /media/  { alias /var/www/media/; expires 1d; add_header Content-Disposition "inline"; }

    location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; try_files $uri =404; }
    location / { try_files $uri /index.html; }
}
