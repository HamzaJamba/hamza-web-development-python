# ---- Django ----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080
FRONTEND_URL=http://localhost:8080
TIME_ZONE=Asia/Karachi

# ---- Database (docker-compose uses these) ----
POSTGRES_DB=oilops
POSTGRES_USER=oilops
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://oilops:change-me@db:5432/oilops

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0

# ---- Email (console backend by default) ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=OilOps Pro <noreply@oilops.local>
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# ---- Domain ----
IOT_DEVICE_API_KEY=change-me-device-key
AUTO_WORK_ORDER_ON_CRITICAL_ALERT=True
MAINTENANCE_LEAD_DAYS=7
MAX_UPLOAD_MB=10
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
THROTTLE_ANON=30/min
THROTTLE_USER=600/min
THROTTLE_LOGIN=10/min

# ---- Production hardening (behind HTTPS) ----
SECURE_SSL_REDIRECT=False
COOKIE_SECURE=False
HSTS_SECONDS=0
